rules_version = '2';

// HausMatch – Firestore-Regeln
// Grundsätze:
//  * Jede Sammlung prüft Besitzer, erlaubte Felder und Längen.
//  * Die Rolle (seeker/manager) und das Admin-Flag "verified" kann ein Nutzer nie selbst ändern.
//  * Schreiben in Postfach, Forum und Netzwerk setzt eine bestätigte E-Mail voraus.
//  * Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(userId) { return signedIn() && request.auth.uid == userId; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isManager() { return signedIn() && myProfile().role == 'manager'; }

    function reqStr(d, k, min, max) { return d[k] is string && d[k].size() >= min && d[k].size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optInt(d, k, min, max) { return !(k in d) || (d[k] is int && d[k] >= min && d[k] <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------------------------------------------------------------- Profile
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'role', 'avatar', 'bio', 'location', 'phone', 'website',
                               'specialization', 'experienceYears', 'openingHours', 'teamSize', 'foundedYear', 'vatId',
                               'serviceCities', 'propertyTypes', 'minUnits', 'maxUnits', 'verified', 'createdAt', 'updatedAt'])
        && reqStr(d, 'name', 1, 80)
        && optStr(d, 'nameLower', 80)
        && d.role in ['seeker', 'manager']
        && optStr(d, 'bio', 1500)
        && optStr(d, 'location', 120)
        && optStr(d, 'phone', 40)
        && optStr(d, 'website', 200)
        && optStr(d, 'vatId', 30)
        && optList(d, 'specialization', 10)
        && optList(d, 'serviceCities', 30)
        && optList(d, 'propertyTypes', 3)
        && optInt(d, 'experienceYears', 0, 100)
        && optInt(d, 'teamSize', 0, 100000)
        && optInt(d, 'foundedYear', 0, 2100)
        && optInt(d, 'minUnits', 0, 100000)
        && optInt(d, 'maxUnits', 0, 100000)
        && (!('openingHours' in d) || d.openingHours is map);
    }
    function avatarOk(d) { return !('avatar' in d) || (d.avatar is string && d.avatar.size() <= 200000); }

    match /users/{userId} {
      // Verwalter-Profile sind öffentlich, Eigentümer-Profile nur für angemeldete Nutzer.
      allow read: if signedIn() || resource.data.role == 'manager';

      allow create: if isUser(userId)
        && validProfile(request.resource.data)
        && avatarOk(request.resource.data)
        && !('verified' in request.resource.data);

      allow update: if isUser(userId)
        && validProfile(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('verified', false) == resource.data.get('verified', false)
        && (request.resource.data.get('avatar', '') == resource.data.get('avatar', '') || avatarOk(request.resource.data));

      allow delete: if isUser(userId);

      // Bearbeitungsstand der Leads – privat pro Verwalter
      match /leadStates/{inquiryId} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['neu', 'kontaktiert', 'archiviert'];
      }
    }

    // --------------------------------------------------------------- Anfragen
    // Enthalten bewusst keine Kontaktdaten: Verwalter melden sich über das Postfach.
    match /inquiries/{inquiryId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isManager());

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'city', 'cityLower', 'units', 'propertyType', 'servicesNeeded',
                                                 'buildingAge', 'condition', 'description', 'status', 'createdAt', 'aiAnalysis'])
        && reqStr(request.resource.data, 'city', 1, 80)
        && reqStr(request.resource.data, 'cityLower', 1, 80)
        && request.resource.data.units is int && request.resource.data.units >= 1 && request.resource.data.units <= 100000
        && request.resource.data.propertyType in ['WEG', 'Mietshaus', 'Gewerbe']
        && request.resource.data.servicesNeeded is list && request.resource.data.servicesNeeded.size() <= 12
        && optStr(request.resource.data, 'buildingAge', 20)
        && optStr(request.resource.data, 'condition', 40)
        && reqStr(request.resource.data, 'description', 10, 4000)
        && request.resource.data.status == 'offen'
        && request.resource.data.createdAt == request.time
        && (!('aiAnalysis' in request.resource.data) || request.resource.data.aiAnalysis is map);

      // Eigentümer dürfen nur den Status ändern (und Alt-Felder mit Kontaktdaten entfernen).
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && changedOnly(['status', 'ownerName', 'ownerEmail'])
        && request.resource.data.status in ['offen', 'geschlossen']
        && !('ownerName' in request.resource.data)
        && !('ownerEmail' in request.resource.data);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------------ Forum
    match /forum_threads/{threadId} {
      allow read: if true;

      allow create: if verified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author == myProfile().name
        && request.resource.data.keys().hasOnly(['title', 'content', 'author', 'authorId', 'category', 'replies', 'createdAt'])
        && reqStr(request.resource.data, 'title', 3, 150)
        && reqStr(request.resource.data, 'content', 1, 8000)
        && reqStr(request.resource.data, 'category', 1, 60)
        && request.resource.data.replies == 0
        && request.resource.data.createdAt == request.time;

      // Antwortzähler: jeder bestätigte Nutzer darf genau um 1 erhöhen.
      allow update: if verified()
        && changedOnly(['replies', 'lastActivity'])
        && request.resource.data.replies == resource.data.replies + 1
        && request.resource.data.lastActivity == request.time;

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /forum_replies/{replyId} {
      allow read: if true;

      allow create: if verified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author == myProfile().name
        && request.resource.data.keys().hasOnly(['threadId', 'content', 'author', 'authorId', 'createdAt'])
        && reqStr(request.resource.data, 'threadId', 1, 100)
        && exists(/databases/$(database)/documents/forum_threads/$(request.resource.data.threadId))
        && reqStr(request.resource.data, 'content', 1, 8000)
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // --------------------------------------------------------------- Postfach
    match /messages/{messageId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);

      allow create: if verified()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName == myProfile().name
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'receiverId', 'receiverName', 'subject',
                                                 'content', 'timestamp', 'read', 'inquiryId'])
        && reqStr(request.resource.data, 'receiverName', 1, 80)
        && optStr(request.resource.data, 'subject', 150)
        && optStr(request.resource.data, 'inquiryId', 100)
        && reqStr(request.resource.data, 'content', 1, 4000)
        && request.resource.data.read == false
        && request.resource.data.timestamp == request.time;

      // Empfänger darf ausschließlich "gelesen" setzen.
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && changedOnly(['read'])
        && request.resource.data.read == true;
    }

    // --------------------------------------------------------------- Netzwerk
    // Dokument-ID = "<kleinere uid>_<größere uid>"
    match /connections/{connectionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      allow create: if verified()
        && request.resource.data.keys().hasOnly(['users', 'requesterId', 'status', 'createdAt'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && connectionId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Nur die angefragte Person kann annehmen.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requesterId
        && changedOnly(['status'])
        && request.resource.data.status == 'accepted';

      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------------------------------------------------------- Kontaktformular
    // Nur anlegen; gelesen wird in der Firebase-Konsole.
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && reqStr(request.resource.data, 'name', 1, 120)
        && reqStr(request.resource.data, 'email', 5, 200)
        && reqStr(request.resource.data, 'message', 10, 4000)
        && request.resource.data.createdAt == request.time;
    }
  }
}
