# --- Server (Vercel > Settings > Environment Variables). NIEMALS mit VITE_ präfixen! ---
GEMINI_API_KEY=
# Optional: Modell überschreiben (Standard: gemini-2.5-flash)
GEMINI_MODEL=

# --- Client (öffentlich, optional – ohne Angabe gelten die Projektwerte aus services/firebase.ts) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Nur lokal: gegen die Firebase-Emulatoren entwickeln (npm run emulators)
VITE_USE_EMULATORS=
